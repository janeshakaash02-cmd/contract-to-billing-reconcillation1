# LLM & Embedding Configuration
# The system works 100% out of the box in DEMO/OFFLINE mode with built-in embeddings & rule-based reasoning.
# To connect to live cloud LLM providers, populate the fields below:

LLM_PROVIDER=demo  # Options: demo, openai, gemini, ollama
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=demo  # Options: demo, openai, chromadb, huggingface
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Storage & Database
DB_PATH=data/reconciliation.db
CHROMA_PERSIST_DIR=data/chromadb

# Reconciliation Policy Defaults
DEFAULT_TOLERANCE_PERCENT=1.0
DEFAULT_TOLERANCE_ABSOLUTE=50.0
DATE_TOLERANCE_DAYS=3
